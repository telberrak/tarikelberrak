# Copy to /srv/tarikelberrak/.env on the server (chmod 600) and fill in. Use single quotes around
# every value. Never commit the real file.
PORTFOLIO_DOMAIN='tarikelberrak.com'
# openssl rand -hex 24  (letters and digits only; init-db.sh sets the same password in PostgreSQL)
PORTFOLIO_DB_PASSWORD=''
# openssl rand -base64 48  (the backend refuses to start with the dev default under the prod profile)
JWT_SECRET=''
ADMIN_EMAIL='tarik.elberrak@gmail.com'

# Optional
STRIPE_SECRET_KEY=''
STRIPE_WEBHOOK_SECRET=''
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USER=''
SMTP_PASSWORD=''
MAIL_FROM=''
CONTACT_NOTIFICATION_EMAIL=''
SENTRY_DSN=''
NEXT_PUBLIC_SENTRY_DSN=''

# Set by the deploy job (the commit being run); don't edit by hand.
TAG='latest'
