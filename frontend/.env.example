# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Backend API (server-only) ---
# Base URL of the Spring Boot API. Next.js server code proxies all reads and
# writes through it; the browser never calls it directly.
API_BASE_URL=http://localhost:8080

# --- Error tracking (optional) ---
# Leave unset to disable Sentry entirely (default). Server and client need
# separate vars because NEXT_PUBLIC_* ships to the browser bundle.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Only needed if you want source maps uploaded to Sentry on build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
